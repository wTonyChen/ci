# Nintendo Switch toolchain for the Chromium build (clang flavour).
#
# Plan A (2026-11-06): the target compiler is Chromium's own clang from
# //third_party/llvm-build, not devkitA64's GCC. Chromium is a clang-only
# codebase (e.g. flat_tree.h deduces through an alias template, which GCC
# refuses), so fighting it with GCC means patching //base forever.
#
# Headers/libraries still come from devkitA64 (newlib + libnx); the CI workflow
# symlinks /opt/devkitpro/devkitA64 and /opt/devkitpro/libnx into third_party/.

import("//build/toolchain/gcc_toolchain.gni")

gcc_toolchain("devkita64") {
  # Both live INSIDE the source tree (ninja cannot depend on a tool outside the
  # checkout) and must be rebased: a literal "//..." is not a runnable path.
  _clang_prefix = rebase_path("//third_party/llvm-build/Release+Asserts/bin",
                              root_build_dir)
  _ar = rebase_path("//third_party/devkitA64/bin/aarch64-none-elf-ar",
                    root_build_dir)

  cc = "${_clang_prefix}/clang"
  cxx = "${_clang_prefix}/clang++"
  ar = _ar
  ld = cxx
  readelf = "${_ar}c"  # unused by the build; kept to satisfy the template
  nm = "${_ar}c"

  toolchain_args = {
    current_cpu = "arm64"
    current_os = "linux"

    is_clang = true
    use_lld = true

    # Target uses devkitA64's libstdc++ (Chromium's libc++ needs a platform
    # layer we do not have on Horizon yet).
    use_custom_libcxx = false
    clang_use_chrome_plugins = false
    use_thin_lto = false

    use_remoteexec = false
    use_reclient = false
  }
}
