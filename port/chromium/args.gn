# Chromium → Nintendo Switch (devkitA64 + newlib), first bring-up args.
#
# Goal of this stage: get `gn gen` to succeed and `ninja base` to compile.
# Everything here mirrors what worked for the Cobalt tree, minus Starboard.

target_os = "linux"
target_cpu = "arm64"

# Default toolchain = devkitA64; host tools stay on Chromium's clang.
custom_toolchain = "//port/chromium/toolchain:devkita64"
host_toolchain = "//build/toolchain/linux:clang_x64"

is_debug = false
symbol_level = 0
dcheck_always_on = false

# No sysroot, no libc++ for the target: devkitA64 ships newlib + libstdc++.
use_sysroot = false
use_custom_libcxx_for_host = true

# Plan A: the target toolchain is clang too now. These stay global because our
# devkitA64 toolchain is the DEFAULT toolchain and GN ignores `toolchain_args`
# for it (see gcc_toolchain.gni: "ignored when this is the default toolchain").
use_custom_libcxx = false
use_thin_lto = false
clang_use_chrome_plugins = false

# The target is linked by devkitA64's own gcc driver + switch.specs (that is how
# the working devkitPro examples are linked). Chromium adds lld-only flags
# (-fuse-ld=lld, --icf=all) whenever use_lld is true, and GNU ld rejects them, so
# turn lld off globally. The host toolchain links with the system GNU ld instead;
# use_thin_archive = false below removes the only reason it needed lld.
use_lld = false
treat_warnings_as_errors = false

# Keep the tree small and avoid subsystems that need a real OS.
# No desktop UI toolkits: the root BUILD.gn gets replaced anyway, but keep
# gn from loading GTK/ozone-X11 code paths if it ever does.
use_gtk = false
# No NSS / D-Bus / CUPS: none of them exist on Horizon and gn would try to
# pkg-config them at generate time.
use_nss_certs = false
use_dbus = false
use_cups = false
# Desktop Linux features that gn would otherwise try to pkg-config at generate
# time. Switch has none of them.
use_glib = false
use_gio = false
use_udev = false
use_libpci = false
use_vaapi = false
use_alsa = false
use_pulseaudio = false
use_x11 = false
use_ozone = false
use_kerberos = false
enable_nacl = false
enable_linux_installer = false
chrome_pgo_phase = 0
use_remoteexec = false
use_reclient = false

# Switch has no PAC/BTI; also keeps -mbranch-protection away from host bindgen.
arm_control_flow_integrity = "none"

# V8: JIT is available on Switch (jitCreate), but the sandbox is not.
v8_enable_sandbox = false

# libnx switch.ld needs a linker that understands linker scripts.
use_mold = false

# Chromium builds thin archives by default on Linux; devkitA64's GNU ld cannot
# read their index ("archive has no index; run ranlib"). Use regular archives.
use_thin_archive = false

# AllocToken pulls in absolute-symbol alias objects (alloc_token_aliases*.o) and
# export-dynamic hints; on a bare-metal PIE they show up as TEXTREL, which the
# Horizon loader does not patch. It is a sanitizer feature we do not need.
use_alloc_token = false

# Crubit's Rust<->C++ bindings assume the in-tree libc++ (they hard-code libc++
# layout), and build/rust/crubit/BUILD.gn asserts use_custom_libcxx when this is
# on. We build against devkitA64's libstdc++, so keep Crubit off.
enable_rust_api_from_cpp = false

# NOTE: Rust stays ENABLED (build/rust/rust_target.gni asserts on it), but M3's
# smoke target deliberately depends on a pure-C library instead of //base so the
# link does not drag in Rust std (which needs libunwind). Revisit in M4.

# --- malloc: keep newlib's, do NOT install Chromium's allocator shim ---
# libnx's own init (`__libnx_init` -> `__appInit` -> `fsdevMountSdmc`) calls
# malloc *before* any Chromium constructor can run. With PA installed as malloc
# that first call lands in the shim while PA's root is still uninitialised and
# ImmediateCrash()es (svcBreak, break address 0x0badf00d00000001).
# Evidence: sd:/atmosphere/crash_reports/01794613979_010000000000100d.log
#   PC = nx_base_probe+0x74e90 (svcBreak)   LR = +0x27864 (DelegatedAllocFn)
#   stack: __libnx_init -> __appInit -> fsdevMountSdmc -> malloc -> shim
use_allocator_shim = false
use_partition_alloc_as_malloc = false
