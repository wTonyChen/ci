# Temporary root BUILD.gn for the Nintendo Switch bring-up.
#
# Two jobs:
#   1. provide `switch_config`, the one config that every *target* compile needs
#      (defines, fake POSIX headers, force-included compat header). It is wired
#      into BUILDCONFIG's default_compiler_configs by port/chromium/patch.py,
#      guarded with `if (!is_clang)` so the host toolchain stays untouched.
#   2. replace the real root BUILD.gn, whose gn_all pulls in every desktop-only
#      target (GTK, CUPS, libva, D-Bus, ...) and makes `gn gen` fail at the
#      first missing pkg-config package. We only need the engine for now.
#
# Delete this overlay once the port can afford to parse the full graph.

config("switch_config") {
  defines = [
    "__SWITCH__",
    "__linux__",
    "_GNU_SOURCE",
    "_DEFAULT_SOURCE",
    "__STDC_FORMAT_MACROS",
    "__STDC_CONSTANT_MACROS",
  ]

  include_dirs = [
    "//port/chromium/fake_headers",
    "//third_party/libnx/include",
  ]

  # clang needs an explicit target triple and the devkitA64 sysroot-ish paths;
  # it also has to be pointed at libstdc++'s C++ headers (Chromium does this
  # through its own libc++ normally).
  _devkita64 = rebase_path("//third_party/devkitA64/aarch64-none-elf",
                           root_build_dir)
  cflags = [
    "--target=aarch64-none-elf",
    "-isystem",
    "${_devkita64}/include",
    "-isystem",
    "${_devkita64}/include/c++/15.2.0",
    "-isystem",
    "${_devkita64}/include/c++/15.2.0/aarch64-none-elf",
    "-isystem",
    "${_devkita64}/include/c++/15.2.0/backward",
    "-L",
    "${_devkita64}/lib",
  ]

  _compat = rebase_path("//port/chromium/switch_compat.h", root_build_dir)
  cflags += [
    "-include",
    _compat,
  ]
  cflags_cc = cflags
}

group("gn_all") {
  deps = [ "//base:base" ]
}

group("all") {
  deps = [ "//base:base" ]
}

group("default") {
  deps = [ "//base:base" ]
}
