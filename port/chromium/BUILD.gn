# Temporary root BUILD.gn for the Nintendo Switch bring-up.
#
# Two jobs:
#   1. provide `switch_config`, the one config that every *target* compile needs
#      (defines, fake POSIX headers, force-included compat header). It is wired
#      into BUILDCONFIG's default_compiler_configs by port/chromium/patch.py,
#      guarded with `if (!is_clang)` so the host toolchain stays untouched.
#   2. replace the real root BUILD.gn, whose gn_all pulls in every desktop-only
#      target (GTK, CUPS, libva, D-Bus, ...) and makes `gn gen` fail at the
#      first missing pkg-config package. We only need the engine for now.
#
# Delete this overlay once the port can afford to parse the full graph.

config("switch_config") {
  defines = [
    "__SWITCH__",
    "__linux__",
    "_GNU_SOURCE",
    "_DEFAULT_SOURCE",
    "__STDC_FORMAT_MACROS",
    "__STDC_CONSTANT_MACROS",
  ]

  include_dirs = [
    "//port/chromium/fake_headers",
    "//third_party/libnx/include",
  ]

  # clang needs an explicit target triple and the devkitA64 sysroot-ish paths;
  # it also has to be pointed at libstdc++'s C++ headers (Chromium does this
  # through its own libc++ normally).
  _devkita64 = rebase_path("//third_party/devkitA64/aarch64-none-elf",
                           root_build_dir)
  # ORDER MATTERS: libstdc++ headers must come BEFORE the newlib headers, because
  # its <cstdlib> etc. use #include_next to reach the C library header — and
  # #include_next only looks at directories AFTER the current one.
  cflags = [
    "--target=aarch64-none-elf",
    "-isystem",
    "${_devkita64}/include/c++/15.2.0",
    "-isystem",
    "${_devkita64}/include/c++/15.2.0/aarch64-none-elf",
    "-isystem",
    "${_devkita64}/include/c++/15.2.0/backward",
    "-isystem",
    "${_devkita64}/include",
    "-L",
    "${_devkita64}/lib",
  ]

  _compat = rebase_path("//port/chromium/switch_compat.h", root_build_dir)
  cflags += [
    "-include",
    _compat,
  ]
  cflags_cc = cflags
}


# ---------------------------------------------------------------------------
# M3: link a minimal executable against libbase.a + newlib + libnx.
#
# Chromium's normal Linux link config is not usable here (PIE, dynamic linker,
# crt1), so the target gets its own linker config and skips the default configs:
# libnx's switch.ld supplies the memory layout and the entry point (_start).
# ---------------------------------------------------------------------------
config("nx_link") {
  _devkita64 = rebase_path("//third_party/devkitA64/aarch64-none-elf",
                           root_build_dir)
  _libnx = rebase_path("//third_party/libnx", root_build_dir)

  ldflags = [
    "-nostdlib",
    "-no-pie",
    "-Wl,-T",
    "${_libnx}/switch.ld",
    "-L",
    "${_devkita64}/lib",
    "-L",
    "${_libnx}/lib",
    "-Wl,--gc-sections",
    "-Wl,--start-group",
    "${_devkita64}/lib/libc.a",
    "${_devkita64}/lib/libm.a",
    "${_devkita64}/lib/libstdc++.a",
    "${_devkita64}/lib/libsupc++.a",
    "${_libnx}/lib/libnx.a",
    "-Wl,--end-group",
  ]
}

executable("nx_smoke") {
  sources = [ "//port/chromium/smoke_main.cc" ]
  deps = [ "//base" ]
  configs = [ ":nx_link" ]
}

group("gn_all") {
  deps = [ "//base:base" ]
}

group("smoke") {
  deps = [ ":nx_smoke" ]
}

group("all") {
  deps = [ "//base:base" ]
}

group("default") {
  deps = [ "//base:base" ]
}
