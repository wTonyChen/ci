# Temporary root BUILD.gn for the Nintendo Switch bring-up.
#
# Two jobs:
#   1. provide `switch_config`, the one config that every *target* compile needs
#      (defines, fake POSIX headers, force-included compat header). It is wired
#      into BUILDCONFIG's default_compiler_configs by port/chromium/patch.py,
#      guarded with `if (!is_clang)` so the host toolchain stays untouched.
#   2. replace the real root BUILD.gn, whose gn_all pulls in every desktop-only
#      target (GTK, CUPS, libva, D-Bus, ...) and makes `gn gen` fail at the
#      first missing pkg-config package. We only need the engine for now.
#
# Delete this overlay once the port can afford to parse the full graph.

config("switch_config") {
  defines = [
    "__SWITCH__",
    "__linux__",
    "_GNU_SOURCE",
    "_DEFAULT_SOURCE",
    "__STDC_FORMAT_MACROS",
    "__STDC_CONSTANT_MACROS",
  ]

  include_dirs = [
    "//port/chromium/fake_headers",
    "//third_party/libnx/include",
  ]

  # clang needs an explicit target triple and the devkitA64 sysroot-ish paths;
  # it also has to be pointed at libstdc++'s C++ headers (Chromium does this
  # through its own libc++ normally).
  _devkita64 = rebase_path("//third_party/devkitA64/aarch64-none-elf",
                           root_build_dir)
  # ORDER MATTERS: libstdc++ headers must come BEFORE the newlib headers, because
  # its <cstdlib> etc. use #include_next to reach the C library header — and
  # #include_next only looks at directories AFTER the current one.
  cflags = [
    "--target=aarch64-none-elf",
    # The final link is a PIE; without position-independent code the compiler
    # emits absolute relocations inside .text, which libnx's loader does not
    # patch at runtime (that was the instant crash on hardware).
    # -fPIC here (not just -fPIE): some Chromium targets are static libs that end
    # up in a PIE, and -fPIE was not enough to keep .text relocation-free.
    "-fPIC",
    # NOTE: clang rejects `-mtp=soft` ("invalid thread pointer reading mode").
    # devkitPro's GCC uses it to route TLS through libnx's __aarch64_read_tp;
    # clang on AArch64 emits `mrs tpidr_el0` instead, which is the KERNEL thread
    # pointer on Horizon. Any TU that touches TLS would then read kernel memory.
    # So: keep Chromium TUs free of TLS (they mostly are) and do NOT pass -mtp=.
    "-march=armv8-a+crc+crypto",
    "-mtune=cortex-a57",
    "-isystem",
    "${_devkita64}/include/c++/15.2.0",
    "-isystem",
    "${_devkita64}/include/c++/15.2.0/aarch64-none-elf",
    "-isystem",
    "${_devkita64}/include/c++/15.2.0/backward",
    "-isystem",
    "${_devkita64}/include",
    "-L",
    "${_devkita64}/lib",
  ]

  _compat = rebase_path("//port/chromium/switch_compat.h", root_build_dir)
  cflags += [
    "-include",
    _compat,
  ]
  cflags_cc = cflags
}


# ---------------------------------------------------------------------------
# M3: link a minimal executable against libbase.a + newlib + libnx.
#
# Chromium's normal Linux link config is not usable here (PIE, dynamic linker,
# crt1), so the target gets its own linker config and skips the default configs:
# libnx's switch.ld supplies the memory layout and the entry point (_start).
# ---------------------------------------------------------------------------
config("nx_link") {
  # Link exactly like the devkitPro examples do: their own driver + switch.specs.
  # Everything we hand-rolled before (lld, custom switch.ld, --start-group order,
  # -z notext) is replaced by the specs file that ships with libnx -- the same
  # one that produces the hello-world binary which does run on hardware.
  _dka = rebase_path("//third_party/devkitA64", root_build_dir)
  _dkp = rebase_path("//third_party/libnx", root_build_dir)
  # Chromium links -latomic/-ldl/-lrt; Horizon has none of them, so point at the
  # empty stub archives instead of failing the link.
  _stubs = rebase_path("//port/chromium/stub_libs", root_build_dir)
  ldflags = [
    "-specs=${_dkp}/switch.specs",
    "-L${_dka}/aarch64-none-elf/lib",
    "-L${_dkp}/lib",
    "-L${_stubs}",
    "-lnx",
    "-lm",
  ]
}

executable("nx_smoke") {
  sources = [
    "//port/chromium/smoke_main.cc",
    # Horizon POSIX/allocator bring-up layer (ported from the Cobalt port).
    "//port/chromium/shims/mmap_shim.cc",
    "//port/chromium/shims/posix_shim.cc",
    "//port/chromium/shims/nx_extra_shim.cc",
  ]
  deps = [ "//third_party/zlib" ]
  # NOTE: `configs = [...]` is rejected ("Replacing nonempty list"); the default
  # configs always arrive first, so append and let the later flags win.
  configs += [ ":nx_link" ]
}

group("gn_all") {
  deps = [ "//base:base" ]
}

group("smoke") {
  deps = [ ":nx_smoke" ]
}

group("all") {
  deps = [ "//base:base" ]
}

group("default") {
  deps = [ "//base:base" ]
}
