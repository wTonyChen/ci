# Nintendo Switch (devkitA64 / libnx) starboard toolchain.
#
# The target toolchain uses overridable_gcc_toolchain, which reads the compiler
# binaries and flags from environment variables (GN_CC_COMPILER, GN_CXX_COMPILER,
# GN_AR_COMPILER, GN_LD_COMPILER, GN_C_FLAGS, GN_CXX_FLAGS, GN_LD_FLAGS), so CI can
# inject aarch64-none-elf-* without hardcoding devkitPro paths here.
import("//build/config/clang/clang.gni")
import("//cobalt/build/configs/hacks.gni")
import("//starboard/build/toolchain/cobalt_toolchains.gni")
import("//starboard/shared/toolchain/overridable_gcc_toolchain.gni")

overridable_gcc_toolchain("starboard") {
  toolchain_args = {
    current_os = "linux"
    current_cpu = "arm64"
    is_starboard = true

    # Without these, //build/config/compiler keeps treating the toolchain as clang
    # and passes clang-only flags (-fcolor-diagnostics, -mno-outline, -Wthread-safety,
    # -gsimple-template-names, ...) which devkitA64's g++ rejects.
    is_clang = false
    use_lld = false
    use_thin_lto = false
    use_custom_libcxx = false
    clang_use_chrome_plugins = false
    treat_warnings_as_errors = false

    # newlib-based target: use devkitA64's libstdc++, not Chromium's bundled libc++.
    build_base_with_cpp17 = true
    enable_base_tracing = false
  }
  propagates_configs = !enable_cobalt_hermetic_hacks
}

# Host toolchain for build-time tools; stays x64 on the runner.
clang_toolchain("native_target") {
  toolchain_args = {
    is_starboard = false
    current_os = "linux"
    current_cpu = "x64"
    enable_base_tracing = false
  }
}
