group("starboard_platform") {
  public_deps = [
    ":starboard_platform_sources",
    "//starboard/egl_and_gles",
  ]

  # TODO(chromium-nx): media codecs come from devkitPro portlibs (switch-dav1d,
  # switch-libvpx, ...) rather than building the Linux-flavoured third_party
  # copies, which pull in glibc-only headers (sys/prctl.h, ...).
  deps = []
}

static_library("starboard_platform_sources") {
  check_includes = false
  sources = [
    "//starboard/nx/arm64/system_get_property.cc",
    "//starboard/nx/arm64/system_get_property_impl.cc",
    "//starboard/shared/libjpeg/jpeg_image_decoder.cc",
    "//starboard/shared/libjpeg/jpeg_image_decoder.h",
  ]

  if (!sb_is_modular || sb_is_evergreen) {
    sources += [ "//starboard/nx/arm64/sanitizer_options.cc" ]
  }

  if (is_internal_build) {
    sources += [ "//starboard/keyboxes/linux/system_properties.cc" ]
  } else {
    sources += [ "//starboard/nx/arm64/public_system_properties.cc" ]
  }

  configs += [ "//starboard/build/config:starboard_implementation" ]
  configs += [
    "//starboard/build/config:starboard",
    "//starboard/nx/arm64/platform_configuration",
  ]

}
