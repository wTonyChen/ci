# Nintendo Switch platform configuration: self-contained (no //starboard/linux).
#
# base_configuration.gni is the declaration entry point for Starboard's global
# variables (font packages, etc.); without it identifiers like
# cobalt_font_package_override_named_sans_serif are undefined.
import("//starboard/build/config/base_configuration.gni")

nasm_exists = false
sb_enable_benchmark = true
sb_enable_opus_sse = false
sb_widevine_platform = ""
platform_tests_path = ""
sb_enable_cast_codec_tests = false

if (current_toolchain == default_toolchain &&
    build_with_separate_cobalt_toolchain) {
  cobalt_font_package = "standard"
} else {
  sabi_path = "//starboard/sabi/arm64/sabi-v18.json"
}
