# Nintendo Switch (libnx / devkitA64) -- Chromium-NX, FIRST CUT.
#
# The import is mandatory: it brings in Cobalt's own declare_args() chain
# (is_cobalt, starboard_target_platform, ...) without which gn ignores our args
# and silently falls back to the linux-x64x11 platform.
import("//cobalt/build/configs/linux_modular_common.gn")

# The target really is aarch64: Starboard derives SB_IS_ARCH_* / SB_SABI_TARGET_ARCH
# from target_cpu, so this must be arm64 (x64 made it take x86 SIMD paths).
target_os = "linux"
target_cpu = "arm64"
is_debug = false
symbol_level = 0

starboard_target_platform = "nx-arm64"

# Bare-metal devkitA64/newlib target: no glibc sysroot, no custom libc.
# Without use_sysroot=false, //build/config/sysroot.gni asserts for an aarch64
# sysroot as soon as current_cpu=arm64 on a linux-ish target_os.
use_sysroot = false
use_custom_libc = false
enable_vulkan = false

# Chromium's bundled libc++ assumes a glibc-style libc (it includes <features.h>),
# which newlib does not have; without this the build fell back to the HOST's
# /usr/include/features.h. Use devkitA64's libstdc++ instead, and keep libc++ for
# host tools (the documented pattern from //build/config/c++/c++.gni).
use_custom_libcxx = false
use_custom_libcxx_for_host = true
