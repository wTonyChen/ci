# Nintendo Switch (libnx / devkitA64) -- Chromium-NX, FIRST CUT.
#
# The import is mandatory: it brings in Cobalt's own declare_args() chain
# (is_cobalt, starboard_target_platform, ...) without which gn ignores our args
# and silently falls back to the linux-x64x11 platform.
import("//cobalt/build/configs/linux_modular_common.gn")

# The target really is aarch64: Starboard derives SB_IS_ARCH_* / SB_SABI_TARGET_ARCH
# from target_cpu, so this must be arm64 (x64 made it take x86 SIMD paths).
target_os = "linux"
target_cpu = "arm64"
is_debug = false
symbol_level = 0

starboard_target_platform = "nx-arm64"

# Bare-metal devkitA64/newlib target: no glibc sysroot, no custom libc.
# Without use_sysroot=false, //build/config/sysroot.gni asserts for an aarch64
# sysroot as soon as current_cpu=arm64 on a linux-ish target_os.
use_sysroot = false
use_custom_libc = false
enable_vulkan = false


# Make the devkitA64 starboard toolchain the DEFAULT toolchain for the whole build.
# Without this only the starboard targets use it and everything else (base, v8, ...)
# is compiled with the host clang, which then pulls in the host's glibc headers.
# Cobalt's //build/config/BUILDCONFIG.gn honours custom_toolchain for exactly this.
custom_toolchain = "//starboard/nx/arm64/toolchain:starboard"

# NOTE: the GCC-specific settings (is_clang etc.) deliberately live in the
# devkitA64 toolchain's toolchain_args, NOT here: a global is_clang=false also
# flips the HOST/native toolchain to GCC, and Chromium's bundled libc++ only
# compiles with clang -> host tools (abseil, protoc, ...) then fail.

# starboard_path is normally derived by //starboard/build/platform_path.gni, but that
# file is only imported through Cobalt targets; targets like //base would otherwise
# see an empty starboard_path (which makes STARBOARD_CONFIGURATION_INCLUDE empty and
# drops every SB_* define). It is a declare_args() variable, so set it directly.
starboard_path = "starboard/nx/arm64"

# Types used by //starboard/BUILD.gn for its aggregate targets; without them
# :starboard / :starboard_unittests are undefined and gn gen reports
# "Unresolved dependencies" (pattern taken from the RDK platform).
starboard_level_final_executable_type = "executable"
starboard_level_gtest_target_type = "executable"

# starboard_toolchain / native_toolchain are declare_args() variables in
# //cobalt/build/configs/initialize_variables.gni, so they can be set here directly
# instead of relying on its derivation (which uses platform_path.gni and produced a
# value that did not match current_toolchain, leaving //starboard:starboard undefined).
starboard_toolchain = "//starboard/nx/arm64/toolchain:starboard"
native_toolchain = "//starboard/nx/arm64/toolchain:native_target"

# GCC treats multi-character constants (fourcc-style 'DMP1') as a warning, but the
# default -Werror=multichar turns it into an error; this is a buildarg, so it has to
# be set here (a toolchain_args entry is silently ignored).

# These are BUILDARGS, and GN uses buildargs (not toolchain_args) for the DEFAULT
# toolchain: with custom_toolchain pointing at our devkitA64 toolchain, the default
# toolchain is ours, so the GCC identity must live here. The non-default
# native_target toolchain overrides them back to clang in its own toolchain_args.
is_clang = false
use_lld = false
use_thin_lto = false
clang_use_chrome_plugins = false
use_custom_libcxx = false
use_custom_libcxx_for_host = true
treat_warnings_as_errors = false

# is_clang=false makes BUILDCONFIG derive host_toolchain = //build/toolchain/linux:x64
# (a GCC host toolchain), and Chromium's bundled libc++ does not compile with GCC;
# pin the host toolchain to the clang one explicitly (declare_args -> args.gn wins).
host_toolchain = "//build/toolchain/linux:clang_x64"
